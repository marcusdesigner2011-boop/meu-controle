# Supabase (Settings > API). Chaves públicas são usadas apenas pelo cliente seguro.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# E-mail (ex.: Resend)
RESEND_API_KEY=
EMAIL_FROM="Meu Controle <no-reply@seudominio.com.br>"

# Protege as rotas de cron (/api/cron/*)
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
