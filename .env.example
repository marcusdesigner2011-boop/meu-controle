# Supabase (Settings > API). NUNCA exponha SERVICE_ROLE no navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Credenciais de produção/teste) - só no servidor
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# E-mail (ex.: Resend)
RESEND_API_KEY=
EMAIL_FROM="Meu Controle <no-reply@seudominio.com.br>"

# Protege as rotas de cron (/api/cron/*)
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
